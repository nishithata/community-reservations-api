# Copy to .env (not committed) or export in your shell.

# Local PostgreSQL (defaults to your OS user over the local socket when unset)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432

# Signing key for JWTs. Defaults to Rails' secret_key_base when unset.
# JWT_SECRET=change-me

# Comma-separated list of allowed browser origins for CORS (defaults to *)
# CORS_ORIGINS=http://localhost:8080,https://your-app.vercel.app

# Password for the seeded admin account (required in production when seeding)
# DEMO_ADMIN_PASSWORD=choose-a-strong-password
