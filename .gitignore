# See https://help.github.com/articles/ignoring-files for more about ignoring files.

/.bundle

# Environment and secrets
/.env*
!/.env.example
/config/master.key
/config/credentials/*.key

# Logs and temp files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Storage
/storage/*
!/storage/.keep

# Editors / OS
.DS_Store
.idea/
.vscode/
